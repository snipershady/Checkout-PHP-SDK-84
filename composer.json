{
    "name": "snipershady/paypal-checkout-sdk",
    "description": "Fork of PayPal's PHP SDK for Checkout REST APIs. PHP 8.4 Compliant",
    "keywords": ["paypal", "payments", "rest", "sdk", "orders", "checkout"],
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "http://github.com/paypal/Checkout-PHP-SDK/",
    "require": {
        "php": ">=8.2",
        "snipershady/paypalhttp": "^1.0.2"
    },
    "authors": [
        {
            "name": "PayPal",
            "homepage": "https://github.com/paypal/Checkout-PHP-SDK/contributors"
        }
    ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92.5",
        "phpunit/phpunit": ">=12.3.14",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "PayPalCheckoutSdk\\": "lib/PayPalCheckoutSdk",
            "Sample\\": "samples/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "scripts": {
        "unit": "phpunit --testsuite unit",
        "integration": "phpunit --testsuite integration"
    }
}
